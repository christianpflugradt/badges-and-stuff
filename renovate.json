{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "internalChecksFilter": "strict",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "rebaseWhen": "behind-base-branch",
  "automerge": false,
  "platformAutomerge": false,
  "minimumReleaseAge": "7 days",
  "extends": [
    "config:best-practices",
    "github>christianpflugradt/please-behave-governance:renovate-governor"
  ],
  "packageRules": [
    {
      "description": "Auto-merge patch, minor, and digest dependency updates after green CI.",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Wait fourteen days before major dependency update PRs because they carry higher change and review risk.",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "!please-behave/cli",
        "!please-behave/action"
      ]
    },
    {
      "description": "Group non-major GitHub Actions updates and apply a fourteen-day cooldown; major updates stay manual.",
      "matchFileNames": [
        ".github/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "groupName": "github-actions",
      "minimumReleaseAge": "14 days",
      "matchPackageNames": [
        "!please-behave/cli",
        "!please-behave/action"
      ]
    }
  ]
}
